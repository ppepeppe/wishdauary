# Generate .env with: sh deploy/init-env.sh
# Initial IP-only smoke test (HTTP). Replace with your EC2 public IPv4.
WISHDIARY_PUBLIC_ORIGIN=http://YOUR_EC2_PUBLIC_IP
WISHDIARY_SITE_ADDRESS=:80

# For HTTPS, point a domain at EC2 and change BOTH values, for example:
# WISHDIARY_PUBLIC_ORIGIN=https://diary.example.com
# WISHDIARY_SITE_ADDRESS=diary.example.com

# Required secrets: init-env.sh generates independent random values.
WISHDIARY_DB_PASSWORD=
WISHDIARY_AUTH_TOKEN_SECRET=

# Normally keep these defaults on EC2. Local tests can use 127.0.0.1 / 18087 / 18443.
WISHDIARY_BIND_ADDRESS=0.0.0.0
WISHDIARY_HTTP_PORT=80
WISHDIARY_HTTPS_PORT=443
