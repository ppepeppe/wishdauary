{
  "name": "wishdiary-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --import ./scripts/register-test-loader.mjs --test tests/*.test.mjs",
    "dev": "vite",
    "check:css": "node scripts/check-css-classes.mjs",
    "build": "npm run check:css && tsc -b && vite build && mkdir -p dist/server && cp worker/index.js dist/server/index.js",
    "preview": "vite preview",
    "mobile:sync": "node scripts/mobile.mjs",
    "mobile:android": "node scripts/mobile.mjs android --development",
    "mobile:ios": "node scripts/mobile.mjs ios --development",
    "mobile:android:apk": "node scripts/mobile.mjs android --development --apk",
    "mobile:icons": "node scripts/mobile-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
